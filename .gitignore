# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Virtual environments ────────────────────────────────────────────
.venv/
.venv-build/
venv/
env/

# ── App runtime data & secrets (NEVER commit) ───────────────────────
master.key
secrets.enc
settings.json
*.db
*.sqlite3
upload_spool/

# ── Build outputs ───────────────────────────────────────────────────
/dist/
/build/
*.deb

# ── Debian packaging artifacts (dpkg-buildpackage regenerates these) ─
debian/case-organizer/
debian/.debhelper/
debian/files
debian/*.debhelper
debian/*.debhelper.log
debian/debhelper-build-stamp
debian/*.substvars

# ── Windows build (fetched vendor binaries, generated icon, cache) ───
windows/vendor/
windows/.cache/
windows/caseorg.ico

# ── Editor / OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Plans & scratch — these must never live in the repo ─────────────
*_PLAN.md
/plans/
